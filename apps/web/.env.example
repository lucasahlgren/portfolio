# Copy to .env.local and fill in. On Vercel, add the same keys under Project → Settings → Environment Variables.

# From sanity.io/manage → your project
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Canonical URL used for metadata, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://lucasahlgren.se

# Shared secret for the Sanity webhook → /api/revalidate
SANITY_REVALIDATE_SECRET=

# Only needed locally for `pnpm seed` (sanity.io/manage → API → Tokens → Editor). Never add to Vercel.
SANITY_API_WRITE_TOKEN=
