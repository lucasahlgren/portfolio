{
  "name": "portfolio",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@portfolio/web",
    "dev:mobile": "turbo run dev --filter=@portfolio/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "format": "turbo run format && prettier --write \"*.{json,md,yaml,yml}\"",
    "format:check": "turbo run format:check && prettier --check \"*.{json,md,yaml,yml}\"",
    "seed": "pnpm --filter @portfolio/sanity seed"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.10"
  }
}
